---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ImageStudio from '../../components/ImageStudio.astro';
import { defaultLocale, locales, type Locale } from '../../config/site';
import { isLocale, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({
      params: { locale },
    }));
}

const localeParam = Astro.params.locale;
const locale: Locale = isLocale(localeParam) ? localeParam : defaultLocale;
const t = useTranslations(locale);

const tools = [
  ['convert', '🖼️'],
  ['resize', '📐'],
  ['transform', '🔄'],
  ['filters', '✨'],
  ['watermark', '©'],
  ['front', '🔒'],
] as const;
---

<BaseLayout title="Online image editor" description={t('site.description')} locale={locale}>
  <Container class="py-14 sm:py-20">
    <section class="hero-grid">
      <div class="hero-copy">
        <p class="section-kicker">{t('home.eyebrow')}</p>
        <h1>{t('home.title')}</h1>
        <p>{t('home.description')}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#editor">{t('home.primaryCta')}</a>
          <a class="btn btn-secondary" href="#tools">{t('home.secondaryCta')}</a>
        </div>
        <div class="badge-row" aria-label="Main benefits">
          <span class="badge">{t('home.privacyBadge')}</span>
          <span class="badge">{t('home.formatsBadge')}</span>
        </div>
      </div>
      <div class="hero-card" aria-hidden="true">
        <div class="mock-toolbar"><span></span><span></span><span></span></div>
        <div class="mock-image">
          <span class="mock-sun"></span>
          <span class="mock-mountain one"></span>
          <span class="mock-mountain two"></span>
        </div>
        <div class="mock-controls">
          <span></span><span></span><span></span>
        </div>
      </div>
    </section>

    <ImageStudio locale={locale} />

    <section id="tools" class="content-section" aria-labelledby="tools-title">
      <div class="section-heading">
        <p class="section-kicker">FácilIMG</p>
        <h2 id="tools-title">{t('tools.title')}</h2>
        <p>{t('tools.description')}</p>
      </div>
      <div class="tool-grid">
        {tools.map(([key, icon]) => (
          <article class="tool-card">
            <span class="tool-icon" aria-hidden="true">{icon}</span>
            <h3>{t(`tools.${key}.title`)}</h3>
            <p>{t(`tools.${key}.description`)}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="split-section" aria-labelledby="how-title">
      <div>
        <p class="section-kicker">Workflow</p>
        <h2 id="how-title">{t('how.title')}</h2>
      </div>
      <ol class="steps-list">
        <li>{t('how.one')}</li>
        <li>{t('how.two')}</li>
        <li>{t('how.three')}</li>
      </ol>
    </section>

    <section id="faq" class="content-section faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-title">{t('faq.title')}</h2>
      </div>
      <div class="faq-list">
        <details open>
          <summary>{t('faq.private.q')}</summary>
          <p>{t('faq.private.a')}</p>
        </details>
        <details>
          <summary>{t('faq.mobile.q')}</summary>
          <p>{t('faq.mobile.a')}</p>
        </details>
        <details>
          <summary>{t('faq.batch.q')}</summary>
          <p>{t('faq.batch.a')}</p>
        </details>
      </div>
    </section>
  </Container>
</BaseLayout>
