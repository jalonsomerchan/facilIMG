---
import Container from './Container.astro';
import { localeLabels, siteConfig, type Locale } from '../config/site';
import { getAlternateLocales, getLocalizedPath, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homeUrl = getLocalizedPath('/', locale);
const alternateLocales = getAlternateLocales(locale);
---

<header class="site-header">
  <Container class="flex items-center justify-between gap-4 py-4">
    <a class="flex items-center gap-3 font-black tracking-tight no-underline" href={homeUrl}>
      <span class="logo-mark" aria-hidden="true">IMG</span>
      <span>{siteConfig.name}</span>
    </a>
    <nav aria-label="Navegación principal" class="flex items-center gap-3 text-sm">
      <a class="nav-link hidden sm:inline-flex" href={homeUrl}>{t('nav.home')}</a>
      <a class="nav-link hidden sm:inline-flex" href={`${homeUrl}#tools`}>{t('nav.tools')}</a>
      <a class="nav-link hidden sm:inline-flex" href={`${homeUrl}#faq`}>{t('nav.faq')}</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar modo claro u oscuro">☾</button>
      {alternateLocales.map((alternateLocale) => (
        <a
          class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs font-bold text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)]"
          href={getLocalizedPath('/', alternateLocale)}
          hreflang={alternateLocale}
        >
          {localeLabels[alternateLocale]}
        </a>
      ))}
    </nav>
  </Container>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-theme-toggle]');
    if (!button) return;
    const sync = () => {
      button.textContent = document.documentElement.dataset.theme === 'dark' ? '☀' : '☾';
    };
    sync();
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      sync();
    });
  })();
</script>
